{
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(uv sync *)",
      "Bash(uv pip list *)",
      "Bash(uv tool run pydoclint --style=google --allow-init-docstring=True *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)",
      "Bash(uv run ty check *)",
      "Bash(mkdir -p .claude/*)",
      "Bash(mkdir -p */.claude/*)",
      "Bash(uv run python .claude/scripts/*)",
      "Bash(uv run python */.claude/scripts/*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Read(*.claude/agent-outputs/**/*.md)",
      "Read(*.claude/bundles/**/*.md)",
      "Read(*.claude/settings.json)",
      "Read(*.claude/skills/**/*.md)",
      "Write(*.claude/agent-outputs/**/*.md)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(chmod 777 *)",
      "Write(*.env*)",
      "Write(*secret*)",
      "Write(*/credentials/*)"
    ]
  }
}
