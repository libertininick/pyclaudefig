{
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(uv sync:*)",
      "Bash(uv pip list:*)",
      "Bash(uv tool run pydoclint --style=google --allow-init-docstring=True:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run ty check:*)",
      "Bash(mkdir -p .claude/agent-outputs/:*)",
      "Bash(mkdir -p .claude/skills/:*)",
      "Bash(uv run python .claude/scripts/generate_bundles.py:*)",
      "Bash(uv run python .claude/scripts/sync_context.py:*)",
      "Bash(uv run python .claude/scripts/validate_code.py:*)",
      "Bash(uv run python .claude/scripts/validate_manifest.py:*)",
      "Bash(uv run python .claude/scripts/run_python_safely.py:*)",
      "Bash(uv run python .claude/scripts/write_markdown_output.py:*)",

      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Read(.claude/agent-outputs/**/*.md)",
      "Write(.claude/agent-outputs/**/*.md)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force:*)",
      "Bash(chmod 777:*)",
      "Write(*.env*)",
      "Write(*secret*)",
      "Write(*/credentials/*)"
    ]
  }
}
